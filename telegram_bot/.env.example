# ==============================================================================
# OptiCleaner Telegram Bot & API Server Configuration
# ==============================================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Comma-separated list of Telegram Admin user IDs (e.g. 123456789,987654321)
ADMIN_IDS=YOUR_TELEGRAM_USER_ID

# Cooldown time in minutes for users requesting activation keys (default: 15)
COOLDOWN_MINUTES=15

# API Server Host and Port (optional)
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=OptiCleaner-Admin-Secret-Key-2026
